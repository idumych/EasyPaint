resource app_signature "application/x-vnd.EasyPaint";

// Opening a file while EasyPaint runs gives it a new window in the
// running app.
resource app_flags B_SINGLE_LAUNCH;

resource app_version {
	major  = 0,
	middle = 2,
	minor  = 0,
	variety = B_APPV_FINAL,
	internal = 0,
	short_info = "EasyPaint",
	long_info = "EasyPaint 0.2.0 - a simple bitmap graphics editor"
};

resource file_types message {
	"types" = "image"
};

// Tool box icons and tool pointers from the original EasyPaint.
resource(100, "cursor_fill") #'PNG ' import "icons/cursor_fill.png";
resource(101, "cursor_loupe") #'PNG ' import "icons/cursor_loupe.png";
resource(102, "cursor_pipette") #'PNG ' import "icons/cursor_pipette.png";
resource(103, "cursor_spray") #'PNG ' import "icons/cursor_spray.png";
resource(104, "tool-cursor") #'PNG ' import "icons/tool-cursor.png";
resource(105, "tool-curve") #'PNG ' import "icons/tool-curve.png";
resource(106, "tool-ellipse") #'PNG ' import "icons/tool-ellipse.png";
resource(107, "tool-fill") #'PNG ' import "icons/tool-fill.png";
resource(108, "tool-lastic") #'PNG ' import "icons/tool-lastic.png";
resource(109, "tool-line") #'PNG ' import "icons/tool-line.png";
resource(110, "tool-loupe") #'PNG ' import "icons/tool-loupe.png";
resource(111, "tool-pencil") #'PNG ' import "icons/tool-pencil.png";
resource(112, "tool-pipette") #'PNG ' import "icons/tool-pipette.png";
resource(113, "tool-rectangle") #'PNG ' import "icons/tool-rectangle.png";
resource(114, "tool-spray") #'PNG ' import "icons/tool-spray.png";
resource(115, "tool-text") #'PNG ' import "icons/tool-text.png";

