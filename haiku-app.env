# haiku-app.env — what the beos-app-platforms release tools need to know about this app.
# Shell syntax: sourced by packaging/*.sh, the CI workflow and the
# release scripts (check-artifact.sh, release-gate.sh). Keep values quoted; no spaces around '='.

# ── Identity ──
APP_NAME="EasyPaint"
APP_CMD="easypaint"
APP_SIG="application/x-vnd.EasyPaint"
RDEF="EasyPaint.rdef"

# ── Version (also in the .rdef app_version and src/Constants.h) ──
VERSION="0.2.0"
REVISION="1"

# ── Package metadata ──
SUMMARY="A simple bitmap graphics editor"
DESCRIPTION_FILE="packaging/description.txt"
HOMEPAGE="https://github.com/Gr1N/EasyPaint"
GITHUB_REPO=""
LICENSE_NAME="MIT"
COPYRIGHT="2012 EasyPaint team"
PACKAGER=""

HPKG_REQUIRES_EXTRA=""
DEB_DEPENDS_EXTRA=""
DEB_SECTION="graphics"
DESKTOP_CATEGORIES="Graphics;2DGraphics;RasterGraphics;"
APPIMAGE_MUST_BUNDLE=""
APPIMAGE_FONTS_EXTRA=""
COSMOE_REPO=""
COSMOE_TAG=""
APPIMAGE_APT_EXTRA=""
DEB_APT_EXTRA=""

# ── Build ──
HPKG_BUILD_DEPS=""
TEST_CMD="make test"
TYPECHECK_SRCS="src/App.cpp src/CanvasView.cpp src/ColorWindow.cpp src/Cursors.cpp src/EffectWindow.cpp src/ImageIO.cpp src/NumberControl.cpp src/PaintWindow.cpp src/Settings.cpp src/SettingsWindow.cpp src/SizeWindow.cpp src/TextWindow.cpp src/ToolBox.cpp src/Tools.cpp"
TYPECHECK_INCLUDES="src src/core"

# ── Feature test ──
FEATURE_CHECKS="draw-save-reopen"
EVIDENCE_1="{p}-saved.txt|PNG image data"
